  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Forge.Auditing/Forge.Auditing.csproj" />
    <ProjectReference Include="../Forge.Core/Forge.Core.csproj" />
  </ItemGroup>
</Project>
