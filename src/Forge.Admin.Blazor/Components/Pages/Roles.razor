@page "/admin/roles"
@using Forge.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject RoleManager<IdentityRole> RoleManager
@inject ForgeIdentityDbContext Db

<h1>Roles &amp; permissions</h1>

<table>
    <caption>Roles and their aggregated permissions</caption>
    <thead><tr><th scope="col">Role</th><th scope="col">Permissions</th></tr></thead>
    <tbody>
        @foreach (var (role, permissions) in _roles)
        {
            <tr><td>@role</td><td>@string.Join(", ", permissions)</td></tr>
        }
    </tbody>
</table>

<h2>Create role</h2>
<form method="post" @onsubmit="CreateRoleAsync" @formname="create-role">
    <AntiforgeryToken />
    <label for="role-name">Role name</label>
    <input id="role-name" name="RoleName" required @bind="RoleName" />
    <button type="submit">Create</button>
</form>

<h2>Grant permission to role</h2>
<form method="post" @onsubmit="GrantAsync" @formname="grant-permission">
    <AntiforgeryToken />
    <label for="grant-role">Role</label>
    <input id="grant-role" name="Grant.Role" required @bind="Grant!.Role" />
    <label for="grant-permission">Permission</label>
    <input id="grant-permission" name="Grant.Permission" required @bind="Grant!.Permission" />
    <button type="submit">Grant</button>
</form>

@if (_message is not null)
{
    <p role="status">@_message</p>
}

@code {
    private List<(string Role, List<string> Permissions)> _roles = [];
    private string? _message;

    [SupplyParameterFromForm(FormName = "create-role")]
    public string? RoleName { get; set; }

    [SupplyParameterFromForm(FormName = "grant-permission")]
    public GrantModel? Grant { get; set; }

    public sealed class GrantModel
    {
        public string Role { get; set; } = "";
        public string Permission { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        Grant ??= new();
        RoleName ??= "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var permissions = await Db.RolePermissions.AsNoTracking().ToListAsync();
        _roles = (await Db.Roles.AsNoTracking().OrderBy(r => r.Name).ToListAsync())
            .Select(r => (r.Name!, permissions.Where(p => p.RoleName == r.Name).Select(p => p.PermissionName).ToList()))
            .ToList();
    }

    private async Task CreateRoleAsync()
    {
        var result = await RoleManager.CreateAsync(new IdentityRole(RoleName ?? ""));
        _message = result.Succeeded ? $"Role '{RoleName}' created." : string.Join("; ", result.Errors.Select(e => e.Description));
        await LoadAsync();
    }

    private async Task GrantAsync()
    {
        Db.RolePermissions.Add(new RolePermission { RoleName = Grant!.Role, PermissionName = Grant.Permission });
        await Db.SaveChangesAsync();
        _message = $"Permission '{Grant!.Permission}' granted to '{Grant.Role}'.";
        await LoadAsync();
    }
}
