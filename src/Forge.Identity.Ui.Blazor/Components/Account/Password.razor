@page "/account/password"
@inject IAccountOperations Account
@inject IStringLocalizer<IdentityUiResources> L

<PageTitle>@L["PasswordTitle"]</PageTitle>
<h1>@L["PasswordTitle"]</h1>

<form method="post" @onsubmit="ChangeAsync" @formname="change-password">
    <AntiforgeryToken />
    <label for="current-password">@L["CurrentPassword"]</label>
    <input id="current-password" name="Model.Current" type="password" autocomplete="current-password" required @bind="Model!.Current" />
    <label for="new-password">@L["NewPassword"]</label>
    <input id="new-password" name="Model.New" type="password" autocomplete="new-password" required @bind="Model!.New" />
    <button type="submit">@L["ChangePasswordButton"]</button>
</form>

@if (_message is not null)
{
    <p role="status">@_message</p>
}

@code {
    private string? _message;

    [SupplyParameterFromForm(FormName = "change-password")]
    public PasswordModel? Model { get; set; }

    public sealed class PasswordModel
    {
        public string Current { get; set; } = "";
        public string New { get; set; } = "";
    }

    protected override void OnInitialized() => Model ??= new();

    private async Task ChangeAsync()
    {
        var result = await Account.ChangePasswordAsync(Model!.Current, Model.New, CancellationToken.None);
        _message = result.IsSuccess ? L["PasswordChanged"]
            : result.Error.Code == IdentityErrors.Denied ? L["NotSignedIn"]
            : result.Error.Message; // Identity's own validation text (already localisable via IdentityErrorDescriber)
        Model = new();
    }
}
