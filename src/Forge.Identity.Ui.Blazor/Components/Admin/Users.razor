@page "/admin/users"
@inject IUserAdministration Admin
@inject IStringLocalizer<IdentityUiResources> L

<PageTitle>@L["UsersTitle"]</PageTitle>
<h1>@L["UsersTitle"]</h1>

<table>
    <caption>@L["UsersCaption"]</caption>
    <thead><tr><th scope="col">@L["UserName"]</th><th scope="col">@L["Roles"]</th></tr></thead>
    <tbody>
        @foreach (var user in _users)
        {
            <tr><td>@user.UserName</td><td>@string.Join(", ", user.Roles)</td></tr>
        }
    </tbody>
</table>

<h2>@L["CreateUser"]</h2>
<form method="post" @onsubmit="CreateAsync" @formname="create-user">
    <AntiforgeryToken />
    <label for="new-username">@L["UserName"]</label>
    <input id="new-username" name="Model.UserName" required @bind="Model!.UserName" />
    <label for="new-password">@L["InitialPassword"]</label>
    <input id="new-password" name="Model.Password" type="password" required @bind="Model!.Password" />
    <button type="submit">@L["Create"]</button>
</form>

<h2>@L["AssignRole"]</h2>
<form method="post" @onsubmit="AssignAsync" @formname="assign-role">
    <AntiforgeryToken />
    <label for="assign-user">@L["UserName"]</label>
    <input id="assign-user" name="Assign.UserName" required @bind="Assign!.UserName" />
    <label for="assign-role">@L["Role"]</label>
    <input id="assign-role" name="Assign.Role" required @bind="Assign!.Role" />
    <button type="submit">@L["Assign"]</button>
</form>

@if (_message is not null)
{
    <p role="status">@_message</p>
}

@code {
    private IReadOnlyList<UserSummary> _users = [];
    private string? _message;

    [SupplyParameterFromForm(FormName = "create-user")]
    public CreateModel? Model { get; set; }

    [SupplyParameterFromForm(FormName = "assign-role")]
    public AssignModel? Assign { get; set; }

    public sealed class CreateModel
    {
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public sealed class AssignModel
    {
        public string UserName { get; set; } = "";
        public string Role { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        Model ??= new();
        Assign ??= new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Admin.ListAsync(50, CancellationToken.None);
        _users = result.IsSuccess ? result.Value : [];
        _message ??= result.IsFailure ? L["NotPermitted"].Value : null;
    }

    private async Task CreateAsync()
    {
        var result = await Admin.CreateAsync(Model!.UserName, Model!.Password, CancellationToken.None);
        _message = result.IsSuccess ? L["UserCreated", Model!.UserName] : result.Error.Message;
        await LoadAsync();
    }

    private async Task AssignAsync()
    {
        var result = await Admin.AssignRoleAsync(Assign!.UserName, Assign!.Role, CancellationToken.None);
        _message = result.IsSuccess ? L["RoleAssigned", Assign!.Role] : result.Error.Message;
        await LoadAsync();
    }
}
