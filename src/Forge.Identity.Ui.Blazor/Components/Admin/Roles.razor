@page "/admin/roles"
@inject IRoleAdministration Admin
@inject IStringLocalizer<IdentityUiResources> L

<PageTitle>@L["RolesTitle"]</PageTitle>
<h1>@L["RolesTitle"]</h1>

<table>
    <caption>@L["RolesCaption"]</caption>
    <thead><tr><th scope="col">@L["Role"]</th><th scope="col">@L["Permissions"]</th></tr></thead>
    <tbody>
        @foreach (var role in _roles)
        {
            <tr><td>@role.Name</td><td>@string.Join(", ", role.Permissions)</td></tr>
        }
    </tbody>
</table>

<h2>@L["CreateRole"]</h2>
<form method="post" @onsubmit="CreateRoleAsync" @formname="create-role">
    <AntiforgeryToken />
    <label for="role-name">@L["RoleName"]</label>
    <input id="role-name" name="RoleName" required @bind="RoleName" />
    <button type="submit">@L["Create"]</button>
</form>

<h2>@L["GrantPermission"]</h2>
<form method="post" @onsubmit="GrantAsync" @formname="grant-permission">
    <AntiforgeryToken />
    <label for="grant-role">@L["Role"]</label>
    <input id="grant-role" name="Grant.Role" required @bind="Grant!.Role" />
    <label for="grant-permission">@L["Permission"]</label>
    <input id="grant-permission" name="Grant.Permission" required @bind="Grant!.Permission" />
    <button type="submit">@L["Grant"]</button>
</form>

@if (_message is not null)
{
    <p role="status">@_message</p>
}

@code {
    private IReadOnlyList<RoleSummary> _roles = [];
    private string? _message;

    [SupplyParameterFromForm(FormName = "create-role")]
    public string? RoleName { get; set; }

    [SupplyParameterFromForm(FormName = "grant-permission")]
    public GrantModel? Grant { get; set; }

    public sealed class GrantModel
    {
        public string Role { get; set; } = "";
        public string Permission { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        Grant ??= new();
        RoleName ??= "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Admin.ListAsync(CancellationToken.None);
        _roles = result.IsSuccess ? result.Value : [];
        _message ??= result.IsFailure ? L["NotPermitted"].Value : null;
    }

    private async Task CreateRoleAsync()
    {
        var result = await Admin.CreateAsync(RoleName ?? "", CancellationToken.None);
        _message = result.IsSuccess ? L["RoleCreated", RoleName ?? ""] : result.Error.Message;
        await LoadAsync();
    }

    private async Task GrantAsync()
    {
        var result = await Admin.GrantPermissionAsync(Grant!.Role, Grant.Permission, CancellationToken.None);
        _message = result.IsSuccess ? L["PermissionGranted", Grant!.Permission, Grant.Role] : result.Error.Message;
        await LoadAsync();
    }
}
