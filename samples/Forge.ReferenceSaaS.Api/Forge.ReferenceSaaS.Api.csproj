<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- OCI image via SDK container publish (ADR 25): no Dockerfile, non-root -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>forge/referencesaas-api</ContainerRepository>
    <ContainerUser>$(APP_UID)</ContainerUser>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../modules/ReferenceCatalog/Forge.ReferenceCatalog/Forge.ReferenceCatalog.csproj" />
    <ProjectReference Include="../../src/Forge.Admin.Blazor/Forge.Admin.Blazor.csproj" />
    <ProjectReference Include="../../src/Forge.Identity.Ui.Blazor/Forge.Identity.Ui.Blazor.csproj" />
    <ProjectReference Include="../../src/Forge.Jobs.Quartz/Forge.Jobs.Quartz.csproj" />
    <ProjectReference Include="../../src/Forge.Localization/Forge.Localization.csproj" />
    <ProjectReference Include="../Forge.ReferenceSaaS.ServiceDefaults/Forge.ReferenceSaaS.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
